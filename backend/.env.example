# RailRadar Live Train Telemetry API
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in
RAILRADAR_TIMEOUT_SECONDS=10
RAILRADAR_CACHE_SECONDS=30
RAILRADAR_MIN_REQUEST_INTERVAL_SECONDS=30
TRAIN_DATA_MODE=live

# Database Configuration (Defaults to SQLite for instant local zero-setup)
DATABASE_URL=sqlite:///./abps.db

# JWT Security
SECRET_KEY=ir-abps-super-secret-key-change-in-production-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Planning Safety Buffers (Minutes)
BUFFER_BEFORE_MIN=5
BUFFER_AFTER_MIN=5
PLANNING_HORIZON_HOURS=24
SOLVER_TIME_LIMIT_SECONDS=15

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
