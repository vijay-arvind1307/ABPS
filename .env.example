# Database Configuration (Defaults to SQLite for instant local zero-setup)
DATABASE_URL=sqlite:///./abps.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/abps_db

# JWT Security
SECRET_KEY=ir-abps-super-secret-key-change-in-production-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Train Data Provider Configuration
TRAIN_DATA_MODE=mock
# Set to live when utilizing RailRadar live provider:
TRAIN_DATA_MODE=live
RAILRADAR_API_KEY=rg_3831164541ac4980ac482afe8d396989

# Planning Safety Buffers (Minutes)
BUFFER_BEFORE_MIN=5
BUFFER_AFTER_MIN=5
PLANNING_HORIZON_HOURS=24
SOLVER_TIME_LIMIT_SECONDS=15

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
